PORT=4310
HOST=127.0.0.1
# For a shared deployment, set the exact HTTPS origin and use a TLS reverse proxy.
APP_ORIGIN=http://localhost:4310
COOKIE_SECURE=false
# Google OAuth web application credentials. Keep the secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Google Workspace domain allowed to join without an invitation.
# If empty, new members still need an invitation.
GOOGLE_ALLOWED_DOMAIN=
# Optional: absolute path to codex.exe when it is not on the server PATH.
CODEX_BIN=
# Optional: keep application data on a persistent volume.
DATA_DIR=./data
